# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Project outputs (large / regenerable) ----
# Trained models, training logs/curves
checkpoints/
*.pt
*.pth
*.ckpt

# Benchmark results (dated dirs: manifest/records/summary/plots/traces)
results/

# Standalone media artifacts
*.gif
*.mp4
*.png
*.jpg
*.jpeg
# ...but keep any docs/figures you deliberately commit:
!docs/**/*.png
!README_assets/**/*.png

# ---- Slurm / HPC ----
# Job stdout/stderr logs
slurm-*.out
slurm-*.err
logs/
*.log

# Node-local scratch copies
scratch/

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db